# Copy to `.env.local` — never commit `.env*` (gitignored).

# --- Minimum to run ---
OPENROUTER_API_KEY=
WALLET_REST_TOKEN=
OPENROUTER_MODEL=google/gemini-3-flash-preview
# OPENROUTER_MODEL_PREMIUM=anthropic/claude-sonnet-4   # optional, use when wiring “stronger model” flows

# OpenRouter attribution (use your deployed site URL in production)
OPENROUTER_HTTP_REFERER=http://localhost:3000

# Wallet REST base (optional override)
# WALLET_REST_BASE_URL=https://rest.budgetbakers.com/wallet
# Token above is from Wallet app: Settings → Integrations → REST API (Premium).

# Optional: calendar fallback when POST /api/chat has no clientTimeZone (API scripts, tests). Chat uses browser Intl zone first.
# FRING_USER_TIMEZONE=Asia/Dubai

# Optional: max model messages replayed per /api/chat turn (assistant/user/tool). Default 40. Set lower to trim long threads harder.
# FRING_CHAT_MAX_MESSAGES=40

# --- Access gate: required on Vercel prod; omit both locally to skip /login ---
# Long random passphrase you enter once at /login per browser profile.
FRING_ACCESS_PASSWORD=
# Signing key for session JWT — openssl rand -hex 32 — never reuse as FRING_ACCESS_PASSWORD.
FRING_AUTH_SECRET=
